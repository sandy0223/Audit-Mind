# --- Hindsight (memory) ---
# Hindsight Cloud: create an API key at https://ui.hindsight.vectorize.io
# (promo code MEMHACK99 in Billing for $50 credits)
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
# One bank for the whole restaurant group, so cross-outlet patterns can be found.
HINDSIGHT_BANK_ID=spice-route-compliance

# --- Groq (LLM) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Band (chat rooms) ---
# app.band.ai -> Agents -> create an External agent -> copy UUID + API key
BAND_AGENT_ID=your_band_agent_uuid_here
BAND_API_KEY=your_band_api_key_here

# --- Demo switches ---
# Set to "false" to run the same agent with no memory (the "before" in the demo).
MEMORY_ENABLED=true
# Log every retain/recall/reflect call to the console (great for the demo video).
MEMORY_TRACE=true